{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlphaMap Open Benchmark contract",
  "contract_version": "1.0.0",
  "tables": {
    "entities.csv": {
      "primary_key": [
        "entity_id"
      ],
      "required": [
        "entity_id",
        "legal_name",
        "domicile",
        "infrastructure_layer"
      ]
    },
    "security_mappings.csv": {
      "primary_key": [
        "security_id",
        "valid_from"
      ],
      "required": [
        "security_id",
        "entity_id",
        "ticker",
        "exchange",
        "currency",
        "valid_from",
        "valid_to"
      ]
    },
    "sources.csv": {
      "primary_key": [
        "source_id"
      ],
      "required": [
        "source_id",
        "source_type",
        "publisher",
        "title",
        "url",
        "published_at",
        "publication_precision",
        "retrieved_at",
        "source_locator"
      ]
    },
    "timestamp_policies.csv": {
      "primary_key": [
        "timestamp_policy_id"
      ],
      "required": [
        "timestamp_policy_id",
        "description",
        "availability_rule",
        "tradability_rule"
      ]
    },
    "events.csv": {
      "primary_key": [
        "event_id",
        "vintage_id"
      ],
      "required": [
        "event_id",
        "vintage_id",
        "subject_entity_id",
        "impact_entity_id",
        "security_id",
        "event_type",
        "evidence_stage",
        "direction",
        "claim_label",
        "published_at",
        "available_at",
        "tradable_from",
        "timestamp_policy_id",
        "alpha_feature_eligible",
        "source_id",
        "source_locator",
        "summary"
      ]
    },
    "observations.csv": {
      "primary_key": [
        "observation_id",
        "vintage_id"
      ],
      "required": [
        "observation_id",
        "vintage_id",
        "event_id",
        "metric_name",
        "numeric_value",
        "text_value",
        "unit",
        "comparator",
        "period_start",
        "period_end",
        "as_of_date",
        "claim_label",
        "available_at",
        "source_id",
        "source_locator"
      ]
    },
    "relationships.csv": {
      "primary_key": [
        "relationship_id",
        "vintage_id"
      ],
      "required": [
        "relationship_id",
        "vintage_id",
        "from_entity_id",
        "to_entity_id",
        "relationship_type",
        "product",
        "valid_from",
        "valid_to",
        "confidence_tier",
        "alpha_feature_eligible",
        "source_id",
        "source_locator"
      ]
    }
  },
  "enums": {
    "direction": [
      "negative",
      "neutral",
      "positive"
    ],
    "claim_label": [
      "reported_fact",
      "issuer_claim",
      "derived_value",
      "estimate",
      "relationship_assertion"
    ],
    "publication_precision": [
      "exact",
      "date_only"
    ],
    "alpha_feature_eligible": [
      "true",
      "false"
    ],
    "confidence_tier": [
      "confirmed",
      "corroborated",
      "indicated"
    ]
  },
  "temporal_invariants": [
    "published_at <= available_at <= tradable_from",
    "period_start <= period_end",
    "valid_from <= valid_to when populated"
  ],
  "observation_invariant": "exactly one of numeric_value or text_value must be populated"
}
